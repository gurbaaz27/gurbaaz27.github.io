---
import { normalizeWalinePath } from "../lib/post-utils";

interface Props {
  title: string;
  subtitle?: string;
  type?: "page" | "post";
  dateText?: string;
  minutes?: number;
  postUrl?: string;
}
const { title, subtitle = "", type = "page", dateText, minutes, postUrl } = Astro.props;
const walinePath = postUrl ? normalizeWalinePath(postUrl) : undefined;
---

<header class="intro-header">
  <div class="content-column heading-column">
    <div class={`${type}-heading`}>
      <h1 set:html={title}></h1>
      {subtitle && (type === "page" ? <><hr class="small" /><span class="page-subheading" set:html={subtitle}></span></> : <h2 class="post-subheading" set:html={subtitle}></h2>)}
      {type === "post" && (
        <div class="post-header-meta">
          <span class="post-meta">{dateText}{minutes != null ? ` | ${minutes} minutes read` : ""}</span>
          <span class="post-meta view-count" data-waline-view-path={walinePath} hidden><span class="middot">·</span> <span class="view-count-text">Loading views...</span></span>
          <span class="post-meta comment-count" data-waline-comment-path={walinePath} data-hide-when-zero hidden><span class="middot">·</span> <span class="comment-count-text">Loading comments...</span></span>
          <span class="post-meta upvote-wrapper">
            <span class="middot">·</span>
            <button class="upvote-button" id="upvote-btn" data-waline-reaction-path={walinePath} aria-label="Upvote this post" aria-pressed="false">
              <svg class="upvote-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L4 10h3v10h10V10h3L12 2z"></path></svg>
            </button>
            <span class="upvote-count" id="upvote-count">0</span>
          </span>
          <br />
          <button class="post-disable-highlight" id="disable-highlights" type="button"><u>Disable the highlights</u></button>
        </div>
      )}
    </div>
  </div>
</header>
